meta {
  name: Post Echo JSON
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/post
  body: json
  auth: bearer
}

auth:bearer {
  token: {{apiKey}}
}

body:json {
  {
    "client": "Poppy",
    "version": "1.0.0"
  }
}

tests {
  test("Status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("Echo received JSON payload", function() {
    var data = res.getBody();
    expect(data.json.client).to.equal("Poppy");
  });
}
