meta {
  name: Get IP Info
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/get
  body: none
  auth: none
}

headers {
  Accept: application/json
}

assertions {
  res.status eq 200
  res.responseTime lt 5000
}

tests {
